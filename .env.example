# ========================================================
# People Like Me — Environment Configuration
# ========================================================

# 1. GEMINI AI API (Server-Side)
# Required for drafting move profiles and 1-sentence match reasoning.
# In Google AI Studio, this is automatically injected or configured via Secrets panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. GOOGLE SIGN-IN / GMAIL OAUTH (Client-Side)
# To enable the official Google account chooser popup button:
# 1. Go to Google Cloud Console (https://console.cloud.google.com/apis/credentials).
# 2. Create an OAuth 2.0 Web Client ID.
# 3. Add your app URL as an Authorized JavaScript Origin.
# 4. Paste the Client ID here.
VITE_GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# 3. SUPABASE DATABASE & AUTH (Optional for Cloud Persistence)
# To connect a hosted PostgreSQL database with Row Level Security:
# Create a project at https://supabase.com and copy these credentials:
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# 4. RESEND / SENDGRID EMAIL SERVICE (Optional)
# For automated delivery of .ics calendar invites to user email addresses:
RESEND_API_KEY="re_123456789"

# 5. DEMO MODE (Optional)
# Default false. When true, seeds 12 sample Career Guides and 2 sample pods labelled "Sample profile".
DEMO_MODE="false"
VITE_DEMO_MODE="false"

# 6. APP HOST URL
APP_URL="MY_APP_URL"
PORT=3000
