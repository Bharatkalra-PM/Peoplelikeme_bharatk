# Gemini API Key (server-side only)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Feature Flags
# PODS_ENABLED: default false for Phase 1 Guide-First 4-Week Pilot (set to true in Phase 2 to re-enable peer pods)
PODS_ENABLED="false"
VITE_PODS_ENABLED="false"

# Demo Mode (optional)
DEMO_MODE="false"
VITE_DEMO_MODE="false"

# Supabase (optional client/server persistence)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
